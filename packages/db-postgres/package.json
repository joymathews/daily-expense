{
  "name": "@daily-expense/db-postgres",
  "version": "1.0.0",
  "description": "High-performance PostgreSQL database repository adapter for Daily Expense",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest --runInBand",
    "migrate:latest": "knex --knexfile knexfile.ts migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.ts migrate:rollback",
    "migrate:status": "knex --knexfile knexfile.ts migrate:status",
    "migrate:make": "knex --knexfile knexfile.ts migrate:make -x ts"
  },
  "dependencies": {
    "@daily-expense/db-contracts": "^1.0.0",
    "knex": "^3.1.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
